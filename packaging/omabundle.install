post_install() {
  cat <<'EOF'
omabundle installed.

Enable double-click installation as your normal user (never as root):
  omabundle integration enable

Then open a downloaded .AppImage, .flatpak, .pkg.tar.* or portable archive
in your file manager. Arch packages open a visible terminal because pacman
needs sudo; everything else installs silently in the background.
EOF
}

post_upgrade() {
  post_install
}

pre_remove() {
  cat <<'EOF'
If double-click installation is still enabled, remove it as your normal user
before deleting the package:
  omabundle integration disable
EOF
}
